{
  "name": "@newemby/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "db:migrate": "tsx src/database/cli.ts up",
    "db:rollback": "tsx src/database/cli.ts down",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@fastify/swagger": "^9.5.1",
    "@newemby/contracts": "workspace:*",
    "@newemby/emby-client": "workspace:*",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^5.0.3",
    "kysely": "^0.28.4",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "tsx": "^4.20.3"
  }
}
