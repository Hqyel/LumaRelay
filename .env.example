NODE_ENV=development

# These values start the local development stack without Docker. Production
# rejects these development keys and every HTTP origin; see README for key
# generation commands before using Compose.
NEWEMBY_DOMAIN=localhost
NEWEMBY_PUBLIC_ORIGIN=http://127.0.0.1:5173

# First release: one active Emby server and an exact origin allowlist.
EMBY_BASE_URL=http://127.0.0.1:8096
EMBY_ALLOWED_SERVER_ORIGINS=http://127.0.0.1:8096

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3000
GATEWAY_TRUST_PROXY=1
DATABASE_PATH=./data/newemby.db
LOG_LEVEL=info

# Development-only values. Production must use independently generated values.
SESSION_SECRET=development-only-session-secret-32
TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
COOKIE_SECURE=false

# Exact Web origins returned to a newly paired Bridge; wildcards are not accepted.
BRIDGE_ALLOWED_ORIGINS=http://127.0.0.1:5173

# The browser uses the same origin in production.
VITE_API_BASE_URL=/api/v1
