NODE_ENV=development

# Public NewEmby origin. Production must use HTTPS.
NEWEMBY_DOMAIN=newemby.example.com
NEWEMBY_PUBLIC_ORIGIN=https://newemby.example.com

# First release: one active Emby server and an exact origin allowlist.
EMBY_BASE_URL=https://emby.example.com
EMBY_ALLOWED_SERVER_ORIGINS=https://emby.example.com

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3000
GATEWAY_TRUST_PROXY=1
DATABASE_PATH=/data/newemby.db
LOG_LEVEL=info

# Generate unique values outside the repository before production use.
SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
COOKIE_SECURE=true

# Reserved for M2. Use exact origins; wildcards are not accepted.
BRIDGE_ALLOWED_ORIGINS=https://newemby.example.com

# The browser uses the same origin in production.
VITE_API_BASE_URL=/api/v1
