NODE_ENV=development

# These values start the local development stack without Docker. Production
# rejects these development keys and every HTTP origin; see README for key
# generation commands before using Compose.
LUMARELAY_DOMAIN=localhost
LUMARELAY_PUBLIC_ORIGIN=http://127.0.0.1:5173
LUMARELAY_IMAGE_TAG=edge

# First release: one active Emby server and an exact origin allowlist.
LUMARELAY_EMBY_BASE_URL=http://127.0.0.1:8096
LUMARELAY_EMBY_ALLOWED_SERVER_ORIGINS=http://127.0.0.1:8096

LUMARELAY_HOST=0.0.0.0
LUMARELAY_PORT=3000
LUMARELAY_TRUST_PROXY=1
LUMARELAY_DATABASE_PATH=./data/lumarelay.db
LUMARELAY_LOG_LEVEL=info

# Development-only values. Production must use independently generated values.
LUMARELAY_SESSION_SECRET=development-only-session-secret-32
LUMARELAY_TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
LUMARELAY_COOKIE_SECURE=false

# Exact Web origins returned to a newly paired Bridge; wildcards are not accepted.
LUMARELAY_BRIDGE_ALLOWED_ORIGINS=http://127.0.0.1:5173

# The browser uses the same origin in production.
VITE_LUMARELAY_API_BASE_URL=/api/v1
